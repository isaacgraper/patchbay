# Patchbay Environment Configuration
# Copy this file to .env and adjust as needed

# Backend
PATCHBAY_HOST=0.0.0.0
PATCHBAY_PORT=4333
PATCHBAY_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./patchbay.db

# AI Provider Keys (optional -- fill in when using cloud models)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Frontend (VITE_ prefixed vars are exposed to browser)
VITE_API_URL=http://localhost:4333
VITE_WS_URL=http://localhost:4333
